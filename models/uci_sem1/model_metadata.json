{
  "title": "Student Dropout Early Warning System Using Machine Learning",
  "model": "Random Forest",
  "prediction_point": "End of first semester",
  "threshold": 0.52,
  "features": [
    "previous_academic_gpa_normalized",
    "Age at enrollment",
    "Mother's occupation",
    "Father's occupation",
