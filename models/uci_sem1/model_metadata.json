    "Curricular units 1st sem (enrolled)",
    "Curricular units 1st sem (evaluations)",
    "Curricular units 1st sem (grade)",
    "Semester pass rate"
  ],
  "raw_input_features": [
    "previous_academic_gpa_normalized",
    "Age at enrollment",
    "Mother's occupation",
    "Father's occupation",
    "Mother's qualification",
    "Father's qualification",
    "Gender",
    "Marital status",
    "Scholarship holder",
